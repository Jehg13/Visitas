HTTP_PORT=8080

MYSQL_DATABASE=visitas_recep
MYSQL_USER=visitas_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Public HTTPS origin, with no trailing slash.
PUBLIC_APP_URL=https://visitas.example.com

# Optional: configure SMTP to enable email and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
