HTTP_PORT=8080
# Keep the Flutter web dev server on this fixed port when testing locally.
CORS_ALLOWED_ORIGINS=http://localhost:59459

# Use host.docker.internal when MySQL runs directly on this VPS.
# For a separate database host, set its private DNS name or IP instead.
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=visitas_recep
DB_USER=visitas_app
DB_PASSWORD=replace-with-the-database-user-password
DB_EXTERNAL_HOST=
DB_EXTERNAL_PORT=3306
DB_EXTERNAL_DATABASE=
DB_EXTERNAL_USERNAME=
DB_EXTERNAL_PASSWORD=
INITIAL_ADMIN_LOGIN=
APP_TIME_ZONE=America/Mexico_City

# Business timezone used for kiosk arrival, entry, and exit timestamps.
APP_TIME_ZONE=America/Mexico_City

# Public HTTPS origin, with no trailing slash.
PUBLIC_APP_URL=https://visitas.example.com

# Optional: configure SMTP to enable email and password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
