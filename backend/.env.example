PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=visitas_recep
DB_USER=visitas_app
DB_PASSWORD=visitas_local
# SMTP saliente de Outlook/Microsoft 365. SMTP AUTH debe estar habilitado por TI.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# URL base pública del frontend para enlaces de correo; requerida en producción.
# En desarrollo local puede dejarse vacía (usa http://localhost:5173).
PUBLIC_APP_URL=
# Solo se necesita al ejecutar db:seed:test-users; usa una contraseña local de prueba.
SEED_TEST_PASSWORD=
